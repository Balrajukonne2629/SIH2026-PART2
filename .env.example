# NTRO PS26155 Auditor — Environment Configuration Template
# Copy this file to .env before starting the container or server.

# --- Chunk 1: Initial Bootstrap Passwords (Seeded on first run) ---
# If omitted, cryptographically secure passwords are generated and printed once to stdout during initialization.
INITIAL_REVIEWER_PASSWORD=
INITIAL_UPLOADER_PASSWORD=
INITIAL_VIEWER_PASSWORD=

# --- Chunk 2: JWT Authentication Secret ---
# If omitted, a secure 256-bit secret is generated and stored in data/.jwt_secret (mode 0600)
JWT_SECRET_KEY=

# --- Local AI Inference Configuration ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=30
